{
  "name": "@tm8/cli",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "tm8": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "default": "./dist/discovery/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && chmod +x dist/index.js && ln -sf index.js dist/tm8",
    "test": "vitest run"
  },
  "dependencies": {
    "@tm8/contract": "workspace:*",
    "@tm8/prompt": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.14.0"
  }
}
