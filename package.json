{
  "name": "tm8",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "postinstall": "bash scripts/repair-node-pty.sh",
    "setup": "bash install.sh",
    "setup:status": "bash install.sh --status",
    "setup:dry-run": "bash install.sh --dry-run",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev.mjs --server-only",
    "start": "node scripts/start.mjs",
    "doctor": "node scripts/doctor.mjs",
    "local": "bash deploy/local.sh",
    "local:status": "bash deploy/local.sh --status",
    "local:stop": "bash deploy/local.sh --stop",
    "local:restart": "bash deploy/local.sh --restart",
    "pg": "bash deploy/pg/ensure-cluster.sh",
    "pg:status": "bash deploy/pg/ensure-cluster.sh --status",
    "utho": "bash deploy/utho/deploy.sh",
    "prod": "bash deploy/prod/deploy.sh",
    "prod:status": "bash deploy/prod/deploy.sh --status",
    "prod:restart": "bash deploy/prod/deploy.sh --restart",
    "prod:rollback": "bash deploy/prod/deploy.sh --rollback",
    "prod:stop": "bash deploy/prod/deploy.sh --stop",
    "build": "tsc -b packages/contract packages/prompt packages/server packages/execution packages/cli packages/mcp tools/conformance && chmod +x packages/cli/dist/index.js packages/mcp/dist/cli.js && ln -sf index.js packages/cli/dist/tm8",
    "typecheck": "bun run typecheck:core && bun run typecheck:ui && bun run typecheck:tm8-ui-2.0",
    "typecheck:core": "tsc -b packages/contract packages/prompt packages/server packages/execution packages/cli packages/mcp tools/conformance",
    "typecheck:ui": "tsc -b packages/ui",
    "typecheck:tm8-ui-2.0": "tsc -p packages/tm8_ui_2.0/tsconfig.json --noEmit",
    "build:contract": "tsc -b packages/contract",
    "build:server": "tsc -b packages/server",
    "build:execution": "tsc -b packages/execution",
    "build:cli": "tsc -b packages/cli && chmod +x packages/cli/dist/index.js",
    "build:mcp": "tsc -b packages/mcp && chmod +x packages/mcp/dist/cli.js",
    "test:contract": "cd packages/contract && bun run test",
    "test:conformance": "cd tools/conformance && bun run test",
    "check": "bash tools/ci/check.sh",
    "check:migrations": "bash tools/ci/migrations-check.sh",
    "hooks:install": "git config core.hooksPath tools/ci/hooks && echo 'tm8 git hooks enabled (pre-push runs tools/ci/check.sh --fast)'",
    "hooks:uninstall": "git config --unset core.hooksPath && echo 'tm8 git hooks disabled'"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
