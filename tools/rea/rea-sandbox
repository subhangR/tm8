def refusal(req_id, name, s):
    if name in s.role_tools:  # it runs the target, and this sandbox may hold a licence
        text = (
            f"REA tool {name!r} runs the target, so it runs only in the exec profile: use "
            "`rea-sandbox --profile exec call ...` (a separate sandbox with an executable /exec and "
            "no Ghidra or licensed engines), and keep every call of that debug or capture session on it."
        )
    else:
        text = (
            f"REA tool {name!r} is outside this session's scope (role {s.role_name}: "
            f"{', '.join(s.role['families'])}). Ask the RE Lead Investigator to route it to the "
            "specialist that owns it, or run it from a session with that role."
        )
    return {"jsonrpc": "2.0", "id": req_id, "result": {"content": [{"type": "text", "text": text}], "isError": True}}


class McpFilter:
    """Line-delimited JSON-RPC filter between the MCP client and REA's stdio server."""

    def __init__(self, allowed, session):
        self.allowed = set(allowed)
        self.s = session
        self.pending = set()
        self.lock = threading.Lock()
        self.calls = collections.Counter()
        self.refused = collections.Counter()

    @staticmethod
    def _key(req_id):
        return json.dumps(req_id, sort_keys=True)

    def client_message(self, msg):
        """Returns (forward, reply): forward to REA or answer the client directly."""
        if not isinstance(msg, dict):
            return msg, None
        method = msg.get("method")
        if method == "tools/list" and "id" in msg:
            with self.lock:
                self.pending.add(self._key(msg["id"]))
        elif method == "tools/call":
            name = (msg.get("params") or {}).get("name")
            if name not in self.allowed:
                self.refused[str(name)] += 1
                return None, (refusal(msg.get("id"), name, self.s) if "id" in msg else None)
            self.calls[name] += 1
        return msg, None

    def server_message(self, msg):
        """Drops out-of-scope tools from a tools/list result; True when it changed msg."""
        if not (isinstance(msg, dict) and "id" in msg and isinstance(msg.get("result"), dict)):
            return False
        key = self._key(msg["id"])
        with self.lock:
            hit = key in self.pending
            self.pending.discard(key)
        if hit and isinstance(msg["result"].get("tools"), list):
            msg["result"]["tools"] = [t for t in msg["result"]["tools"] if t.get("name") in self.allowed]
            return True
        return False


def encode(msg):
    return (json.dumps(msg, separators=(",", ":"), ensure_ascii=False) + "\n").encode()


def cmd_mcp(s, _args):
    s.ensure_case()
    filt = McpFilter(s.tools, s)
    with ghidra_slot(s), tempfile.TemporaryDirectory(prefix="rea-sandbox-") as tmp:
        name = container_name(s, "mcp")
        cidfile = Path(tmp) / "cid"
        argv = docker_argv(s, ["mcp"], interactive=True, name=name)
        argv.insert(2, f"--cidfile={cidfile}")
        note(f"role={s.role_name} tools={len(s.tools)} engines={','.join(s.engines) or '-'} case={s.case}")
        t0 = time.monotonic()
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE)
        kill_on_signal(name)
        watch = PeakWatcher(cidfile)
        out = sys.stdout.buffer
        out_lock = threading.Lock()

        def to_client(data):
            with out_lock:
                out.write(data)
                out.flush()

        def pump_client():
            try:
                for line in sys.stdin.buffer:
                    try:
                        msg = json.loads(line)
                    except ValueError:
                        proc.stdin.write(line)
                        proc.stdin.flush()
                        continue
                    if isinstance(msg, list):
                        fwd, replies = [], []
                        for m in msg:
                            f, r = filt.client_message(m)
                            if f is not None:
                                fwd.append(f)
                            if r is not None:
                                replies.append(r)
                        if replies:
                            to_client(encode(replies))
                        if fwd:
                            proc.stdin.write(encode(fwd))
                            proc.stdin.flush()
                        continue
                    fwd, reply = filt.client_message(msg)
                    if reply is not None:
                        to_client(encode(reply))
                    if fwd is not None:
                        proc.stdin.write(line if fwd is msg else encode(fwd))
                        proc.stdin.flush()
            except (BrokenPipeError, OSError):
                pass
            finally:
                with contextlib.suppress(OSError):
                    proc.stdin.close()

        threading.Thread(target=pump_client, daemon=True).start()
        rc = None
        try:
            for line in proc.stdout:
                try:
                    msg = json.loads(line)
                except ValueError:
                    to_client(line)
                    continue
                changed = [filt.server_message(m) for m in msg] if isinstance(msg, list) else [filt.server_message(msg)]
                to_client(encode(msg) if any(changed) else line)
            rc = proc.wait()
        except SystemExit as e:  # kill_on_signal: the container is already killed
            rc = e.code
            raise
        finally:
            watch.stop()
            record_use(s, "mcp", rc if rc is not None else proc.poll(), time.monotonic() - t0, watch.peak,
                       calls=dict(filt.calls), refused=dict(filt.refused))
    return rc


# ---------------------------------------------------------------- warm session over Bash
#
# tm8 lanes run Claude Code with --strict-mcp-config, and tm8's connector bridge
# gives each request 15 s (packages/server/src/mcp/stdio.ts and transport.ts), so
# REA's long, stateful analyses cannot reach a lane as an MCP server. `call` reaches
# them from Bash instead: the first call starts `serve`, one REA MCP container per
# session and role kept warm behind a unix socket (Ghidra analyses a binary once),
# and later calls reuse it until it has been idle for mcp_idle_seconds.


def daemon_socket(s):
    # One warm REA per session, role, profile and case: a call for one case must never reach a
    # warm REA whose /case is another case's folder. The session's own case keeps the plain key.
    key = f"{s.session or 'case-' + s.case_id}-{s.role_name}-{s.profile}"
    if s.case_id != s._case_id(None):
        key += "-" + hashlib.sha256(s.case_id.encode()).hexdigest()[:12]
    path = s.lab / "run" / "mcp" / f"{key}.sock"
    if len(str(path)) > 100:  # a unix socket path must stay under 108 bytes
        path = path.with_name(hashlib.sha256(key.encode()).hexdigest()[:32] + ".sock")
    return path


class McpPipe:
    """JSON-RPC client over a REA `mcp` container's stdio; requests may overlap."""

    def __init__(self, proc):
        self.proc, self.lock, self.waiting, self.next_id, self.closed = proc, threading.Lock(), {}, 0, False
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self):
        for line in self.proc.stdout:
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            with self.lock:
                slot = self.waiting.pop(msg.get("id"), None) if isinstance(msg, dict) else None
            if slot:
                slot["msg"] = msg
                slot["done"].set()
        with self.lock:  # REA is gone: wake every caller still waiting
            self.closed = True
            for slot in self.waiting.values():
                slot["done"].set()
            self.waiting.clear()

    def request(self, method, params):
        with self.lock:
            if self.closed:
                raise OSError("REA has exited")
            self.next_id += 1
            slot = self.waiting[self.next_id] = {"done": threading.Event()}
            self.proc.stdin.write(encode({"jsonrpc": "2.0", "id": self.next_id, "method": method, "params": params}))
            self.proc.stdin.flush()
        slot["done"].wait()
        if "msg" not in slot:
            raise OSError("REA exited before answering")
        return slot["msg"]

    def notify(self, method):
        with self.lock:
            self.proc.stdin.write(encode({"jsonrpc": "2.0", "method": method}))
            self.proc.stdin.flush()


def cmd_serve(s, _args):
    s.ensure_case()
    sock_path = daemon_socket(s)
    sock_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    owner = open(sock_path.with_suffix(".lock"), "a+")
    try:
        fcntl.flock(owner, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0  # another serve already owns this session and role
    owner.seek(0)
    owner.truncate()
    owner.write(json.dumps({"pid": os.getpid(), "role": s.role_name, "case": s.case_id, "member": s.member, "since": time.time()}))
    owner.flush()
    idle = float(s.cfg.get("mcp_idle_seconds", 1200))
    filt = McpFilter(s.tools, s)
    with ghidra_slot(s), tempfile.TemporaryDirectory(prefix="rea-sandbox-") as tmp:
        name = container_name(s, "serve")
        cidfile = Path(tmp) / "cid"
        argv = docker_argv(s, ["mcp"], interactive=True, name=name)
        argv.insert(2, f"--cidfile={cidfile}")
        note(f"serve role={s.role_name} profile={s.profile} tools={len(s.tools)} engines={','.join(s.engines) or '-'} case={s.case}")
        t0 = time.monotonic()
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE)
        kill_on_signal(name)
        watch = PeakWatcher(cidfile)
        rea = McpPipe(proc)
        state = {"busy": 0, "last": time.monotonic(), "stop": False}
        state_lock = threading.Lock()
        rc = None

        def answer(conn, tools):
            with conn, conn.makefile("rwb") as f:
                with state_lock:
                    state["busy"] += 1
                try:
                    req = json.loads(f.readline() or b"{}")
                    op = req.get("op")
                    if op == "tools":
                        resp = {"result": {"tools": tools}}
                    elif op == "stop":
                        state["stop"] = True
                        resp = {"result": {"stopping": True}}
                    elif op == "call":
                        params = {"name": req.get("name"), "arguments": req.get("arguments") or {}}
                        fwd, refused = filt.client_message({"jsonrpc": "2.0", "id": 0, "method": "tools/call", "params": params})
                        resp = refused if fwd is None else rea.request("tools/call", params)
                    else:
                        resp = {"error": {"message": f"unknown op {op!r}"}}
                except (OSError, ValueError, AttributeError) as e:
                    resp = {"error": {"message": str(e)}}
                finally:
                    with state_lock:
                        state["busy"] -= 1
                        state["last"] = time.monotonic()
                with contextlib.suppress(OSError):
                    f.write(encode(resp))
                    f.flush()

        try:
            rea.request("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                       "clientInfo": {"name": "rea-sandbox", "version": "1"}})
            rea.notify("notifications/initialized")
            listed = rea.request("tools/list", {}).get("result") or {}
            tools = [t for t in listed.get("tools", []) if t.get("name") in set(s.role_tools)]
            sock_path.unlink(missing_ok=True)
            srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            srv.bind(str(sock_path))
            sock_path.chmod(0o600)
            srv.listen(16)
            srv.settimeout(2)
            while not state["stop"] and proc.poll() is None:
                try:
                    conn, _ = srv.accept()
                except socket.timeout:
                    with state_lock:
                        if state["busy"] == 0 and time.monotonic() - state["last"] > idle:
                            note(f"idle for {int(idle)} s; stopping")
                            break
                    continue
                threading.Thread(target=answer, args=(conn, tools), daemon=True).start()
        except SystemExit as e:  # kill_on_signal: the container is already killed
            rc = e.code
            raise
        finally:
            sock_path.unlink(missing_ok=True)
            with contextlib.suppress(OSError):
                proc.stdin.close()
            try:
                rc = proc.wait(30) if rc is None else rc
            except subprocess.TimeoutExpired:
                subprocess.run(["docker", "kill", name], capture_output=True)
                rc = proc.wait()
            watch.stop()
            record_use(s, "serve", rc, time.monotonic() - t0, watch.peak,
                       calls=dict(filt.calls), refused=dict(filt.refused))
    return rc or 0


def daemon_request(s, req, start=True, path=None):
    """Send one request to this session's warm REA for the case, starting it first if needed."""
    path = path or daemon_socket(s)
    child, deadline = None, time.monotonic() + float(s.cfg.get("mcp_start_seconds", 300))
    while True:
        try:
            conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            conn.connect(str(path))
            break
        except (FileNotFoundError, ConnectionRefusedError):
            conn.close()
            if not start:
                return None
            if child is None:
                s.ensure_case()
                log = open(s.case / "work" / "serve.log", "ab")
                child = subprocess.Popen(
                    [sys.executable, "-I", str(Path(__file__).resolve()), "--role", s.role_name, "--case", s.case_id,
                     "--profile", s.profile, "serve"],
                    stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
                note(f"starting a warm REA for role {s.role_name}, profile {s.profile} (first call only; log {s.case}/work/serve.log)")
            elif child.poll() not in (None, 0):
                die(f"the warm REA failed to start (exit {child.returncode}); see {s.case}/work/serve.log", 1)
            if time.monotonic() > deadline:
                die(f"the warm REA did not come up; see {s.case}/work/serve.log", 1)
            time.sleep(0.5)
    with conn, conn.makefile("rwb") as f:
        f.write(encode(req))
        f.flush()
        line = f.readline()
    return json.loads(line) if line else {"error": {"message": "the warm REA ended before answering"}}


def cmd_call(s, args):
    if args.tool not in s.tools:
        print(refusal(None, args.tool, s)["result"]["content"][0]["text"], file=sys.stderr)
        s.ensure_case()
        record_use(s, "call", 3, 0, None, echo=False, refused={args.tool: 1})
        return 3
    raw = args.arguments
    if raw == "-":
        raw = sys.stdin.read()
    elif raw and raw.startswith("@"):
        raw = Path(raw[1:]).read_text()
    try:
        arguments = json.loads(raw) if raw else {}
    except ValueError as e:
        die(f"arguments are not JSON: {e}")
    if not isinstance(arguments, dict):
        die("arguments must be a JSON object")
    resp = daemon_request(s, {"op": "call", "name": args.tool, "arguments": arguments})
    if "error" in resp:
        print(json.dumps(resp["error"]), file=sys.stderr)
        return 2
    result = resp.get("result") or {}
    texts = [c.get("text", "") for c in result.get("content", []) if c.get("type") == "text"]
    body = "\n".join(texts) if texts else json.dumps(result.get("structuredContent"))
    out = args.out
    if not out and len(body.encode()) > int(s.cfg.get("call_inline_max_bytes", 100000)):
        # Keep a huge evidence bundle out of the agent's context; say where it went.
        calls = s.case / "out" / "calls"
        calls.mkdir(parents=True, exist_ok=True)
        out = str(calls / f"{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}-{args.tool}-{uuid.uuid4().hex[:6]}.json")
    if out:
        Path(out).write_text(body)
        summary = {"written": out, "bytes": len(body.encode())}
        with contextlib.suppress(ValueError, AttributeError):
            summary["evidence_id"] = json.loads(body).get("evidence_id")
        print(json.dumps(summary))
    else:
        print(body)
    return 1 if result.get("isError") else 0


def cmd_tools(s, args):
    resp = daemon_request(s, {"op": "tools"})
    if "error" in resp:
        print(json.dumps(resp["error"]), file=sys.stderr)
        return 2
    tools = resp["result"]["tools"]
    if args.names:
        missing = sorted(set(args.names) - {t["name"] for t in tools})
        for t in tools:
            if t["name"] in args.names:
                print(json.dumps({"name": t["name"], "description": t.get("description"),
                                  "inputSchema": t.get("inputSchema")}, indent=1))
        if missing:
            note(f"not available to role {s.role_name}: {', '.join(missing)}")
        return 1 if missing else 0
    for t in tools:
        first = (t.get("description") or "").strip().split(". ")[0].replace("\n", " ")
        mark = "exec" if t["name"] in s.foreign else ""
        print(f"{t['name']:<44} {mark:<5} {first[:150]}")
    if s.foreign:
        note("tools marked exec run the target: call them with --profile exec")
    return 0


def cmd_stop(s, args):
    # Every warm REA this session owns, whatever its case, role or profile; with --case, only
    # that case's.
    mine = daemon_socket(s)
    paths = {mine}
    if not args.case and s.session:
        paths |= set(mine.parent.glob(f"{s.session}-*.sock"))
    stopped = sum(1 for p in sorted(paths) if daemon_request(s, {"op": "stop"}, start=False, path=p))
    note(f"stopping {stopped} warm REA(s)" if stopped else "no warm REA is running for this session")
    return 0


# ---------------------------------------------------------------- run / doctor


def cgroup_peak(cid):
    for base in (f"/sys/fs/cgroup/system.slice/docker-{cid}.scope", f"/sys/fs/cgroup/docker/{cid}"):
        p = Path(base) / "memory.peak"
        with contextlib.suppress(OSError, ValueError):
            return int(p.read_text().strip())
    return None


class PeakWatcher:
    """Polls the container's cgroup memory.peak (gVisor reports it too) until stopped."""

    def __init__(self, cidfile):
        self.cidfile, self.peak, self.done = cidfile, None, threading.Event()
        self.thread = threading.Thread(target=self._poll, daemon=True)
        self.thread.start()

    def _poll(self):
        cid = None
        while not self.done.wait(0.25):
            if cid is None and self.cidfile.exists():
                cid = self.cidfile.read_text().strip() or None
            if cid:
                self.peak = cgroup_peak(cid) or self.peak

    def stop(self):
        self.done.set()
        self.thread.join()


def record_use(s, mode, rc, wall, peak, echo=True, **extra):
    """One line per container (or refused call) in the case's work/runs.jsonl, echoed on stderr."""
    record = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "mode": mode, **extra,
        "exit": rc, "wall_s": round(wall, 2), "peak_mem_mib": round(peak / 1048576, 1) if peak else None,
        "role": s.role_name, "profile": s.profile, "engines": s.engines, "member": s.member or None,
        "session": s.session or None,
    }
    with contextlib.suppress(OSError):
        with open(s.case / "work" / "runs.jsonl", "a") as f:
            f.write(json.dumps(record) + "\n")
    if echo:
        print(json.dumps({"rea_sandbox": record}), file=sys.stderr)


def run_container(s, rea_args, extra_env=None, interactive=False, entrypoint=None, tty=False):
    s.ensure_case()
    with ghidra_slot(s), tempfile.TemporaryDirectory(prefix="rea-sandbox-") as tmp:
        name = container_name(s, "run")
        cidfile = Path(tmp) / "cid"
        argv = docker_argv(s, rea_args, interactive=interactive, name=name, extra_env=extra_env,
                           entrypoint=entrypoint, tty=tty)
        argv.insert(2, f"--cidfile={cidfile}")
        kill_on_signal(name)
        t0 = time.monotonic()
        proc = subprocess.Popen(argv)
        watch = PeakWatcher(cidfile)
        rc = None
        try:
            rc = proc.wait()
        except SystemExit as e:  # kill_on_signal: the container is already killed
            rc = e.code
            raise
        finally:
            watch.stop()
            record_use(s, "run", rc if rc is not None else proc.poll(), time.monotonic() - t0, watch.peak,
                       argv=list(rea_args))
    return rc


def cmd_run(s, args):
    rea_args = list(args.rea_args)
    if rea_args and rea_args[0] == "--":
        rea_args = rea_args[1:]
    if not rea_args:
        die("usage: rea-sandbox run -- <rea command and arguments>")
    return run_container(s, rea_args)


def cmd_doctor(s, args):
    rea_args = ["doctor", "--json"] + (["--provider", args.provider] if args.provider else [])
    return run_container(s, rea_args)


# ---------------------------------------------------------------- engines


def sha256_file(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def cmd_engines(s, args):
    rows = []
    for name, spec in s.cfg["engines"].items():
        state = s.engine_state(name)
        row = {"engine": name, "state": state, "dir": str(s.engine_dir(name)), "licensed": bool(spec.get("licensed"))}
        if state == "ready" and spec.get("file_sha256"):
            got = sha256_file(s.engine_dir(name) / spec["check"])
            row["sha256_ok"] = got == spec["file_sha256"]
            if not row["sha256_ok"]:
                row["state"] = "tampered"
        if spec.get("licensed") and row["state"] != "ready":
            readme = f"{s.engine_dir(name)}/README.md"
            row["next"] = {"missing": f"drop your files as {readme} says",
                           "present": f"rea-sandbox setup {name}",
                           "unsupported": f"{spec.get('unsupported')} ({readme})"}.get(row["state"], f"see {readme}")
        rows.append(row)
    if args.json:
        print(json.dumps(rows, indent=1))
    else:
        for r in rows:
            extra = " (licensed)" if r["licensed"] else ""
            nxt = f"  -> {r['next']}" if r.get("next") else ""
            print(f"{r['engine']:<8} {r['state']:<11} {r['dir']}{extra}{nxt}")
    return 0 if all(r["state"] in ("ready", "missing", "present", "unsupported") for r in rows) else 1


def cmd_setup(s, args):
    """Run a licensed slot's setup.sh in the sandbox, with only that slot mounted, read-write."""
    name = args.engine
    spec = s.cfg["engines"].get(name)
    if not spec or not spec.get("licensed"):
        die(f"setup is for the licensed slots: {', '.join(n for n, e in s.cfg['engines'].items() if e.get('licensed'))}")
    if spec.get("unsupported"):
        die(f"{name}: {spec['unsupported']}")
    d = s.engine_dir(name)
    if not (d / "setup.sh").is_file():
        die(f"{d}/setup.sh is missing; run tools/rea/install.sh")
    s.ensure_case()
    fixture, dest = s.lab / "fixtures" / "hello", s.case / "targets" / "hello"
    if fixture.is_file() and not dest.exists():  # the smoke test's target
        shutil.copyfile(fixture, dest)
        dest.chmod(0o444)
    s.engines, s.setup_engine, s.exec_tmpfs = [name], name, True  # installers unpack into /exec
    return run_container(s, [f"/engines/{spec['dir']}/setup.sh"], extra_env={"TMPDIR": "/exec"},
                         interactive=args.interactive, entrypoint="/bin/sh",
                         tty=args.interactive and sys.stdin.isatty())


