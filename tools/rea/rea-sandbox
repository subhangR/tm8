def session_containers(s):
    if not s.session:
        die("TM8_SESSION_ID is not set; run this from the session that owns the container")
    out = subprocess.run(["docker", "ps", "--filter", "label=tm8.rea=1", "--filter", f"label=tm8.rea.session={s.session}",
                          "--filter", f"label=tm8.rea.profile={s.profile}",
                          "--format", "{{.Names}}"], capture_output=True, text=True, check=True).stdout.split()
    return out


def cmd_jeb(s, args):
    if "jeb" not in s.engines:
        die("JEB is not ready for this role; run `rea-sandbox engines`")
    target = args.target
    if not target.startswith("/case/targets/"):
        target = f"/case/targets/{Path(target).name}"
    names = session_containers(s)
    if not names:
        die("no running REA container for this session; JEB starts inside the session's MCP container")
    rc = 0
    for n in names:
        rc |= subprocess.run(["docker", "exec", "-d", n, "/engines/jeb/start-jeb-mcp.sh", target]).returncode
    note(f"JEB MCP starting for {target} in {', '.join(names)}; check with the inspect_jeb_client tool")
    return rc


def cmd_ps(_s, _args):
    return subprocess.run(["docker", "ps", "--filter", "label=tm8.rea=1", "--format",
                           "{{.Names}}\t{{.RunningFor}}\t{{.Label \"tm8.rea.role\"}}\t{{.Label \"tm8.rea.profile\"}}\t{{.Label \"tm8.rea.case\"}}\t{{.Label \"tm8.rea.member\"}}"]).returncode


def main():
    ap = argparse.ArgumentParser(prog="rea-sandbox", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--role", help="the role for a session no teammate mapping covers (default: from TM8_TEAM_MEMBER_ID)")
    ap.add_argument("--case", help="case folder name under <lab>/cases (default: first TM8_TASK_IDS)")
    ap.add_argument("--profile", choices=["static", "exec"], help="static (default): every engine, no tool that runs "
                    "the target; exec: run the target, without licensed or heavy engines")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("call")
    p.add_argument("tool")
    p.add_argument("arguments", nargs="?", help="JSON object, @file or - for stdin (default {})")
    p.add_argument("--out", help="write the full result here and print only its size and evidence id "
                   "(automatic, under the case's out/calls, past call_inline_max_bytes)")
    p = sub.add_parser("tools")
    p.add_argument("names", nargs="*")
    sub.add_parser("stop")
    sub.add_parser("serve")
    sub.add_parser("mcp")
    p = sub.add_parser("run")
    p.add_argument("rea_args", nargs=argparse.REMAINDER)
    p = sub.add_parser("doctor")
    p.add_argument("provider", nargs="?")
    p = sub.add_parser("engines")
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("intake")
    p.add_argument("sources", nargs="+")
    p.add_argument("--name", help="file name in the case (single source only)")
    p.add_argument("--note", help="provenance note: where it came from, who authorized it")
    p = sub.add_parser("scope")
    p.add_argument("--tools", action="store_true")
    p = sub.add_parser("jeb")
    p.add_argument("target")
    p = sub.add_parser("setup")
    p.add_argument("engine", help="a licensed slot (ida, jeb, hopper); see <lab>/engines/<slot>/README.md")
    p.add_argument("--interactive", action="store_true", help="attach a terminal for a vendor's first-use prompts")
    sub.add_parser("ps")
    args = ap.parse_args()
    if args.cmd in ("run", "setup") and args.profile:
        die(f"{args.cmd} sets its own profile; --profile applies to call, tools, stop and mcp")
    s = Session(load_config(), role=args.role, case=args.case or (f"setup-{args.engine}" if args.cmd == "setup" else None),
                profile="cli" if args.cmd == "run" else args.profile or "static")
    handler = {"call": cmd_call, "tools": cmd_tools, "stop": cmd_stop, "serve": cmd_serve, "mcp": cmd_mcp, "run": cmd_run, "doctor": cmd_doctor, "engines": cmd_engines, "intake": cmd_intake,
               "scope": cmd_scope, "jeb": cmd_jeb, "setup": cmd_setup, "ps": cmd_ps}[args.cmd]
    if args.cmd not in ("mcp", "serve"):
        sys.exit(handler(s, args))
    # Their reader threads are daemons blocked on a pipe, and a normal interpreter
    # shutdown aborts on that buffer's lock (SIGABRT), so leave without one once the
    # container is gone, the Ghidra slot released and the session recorded.
    try:
        rc = handler(s, args)
    except SystemExit as e:
        rc = e.code
    sys.stdout.flush()
    sys.stderr.flush()
    os._exit(rc if isinstance(rc, int) else 1)


if __name__ == "__main__":
    main()
