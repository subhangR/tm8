HERE = Path(__file__).resolve().parent
ID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
CASE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$")
# The image's PATH (tools/rea/Dockerfile); engines may append to it, never prepend.
IMAGE_PATH = "/opt/rea/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"


def die(msg, code=2):
    print(f"rea-sandbox: {msg}", file=sys.stderr)
    sys.exit(code)


def note(msg):
    print(f"rea-sandbox: {msg}", file=sys.stderr, flush=True)


def load_config():
    explicit = os.environ.get("REA_SANDBOX_CONFIG")
    for p in [Path(explicit)] if explicit else [Path("/home/tm8/rea-lab/etc/rea-sandbox.json"), HERE / "rea-sandbox.json"]:
        if p.is_file():
            cfg = json.loads(p.read_text())
            cfg["_path"] = str(p)
            cat = Path(cfg["catalog"])
            cfg["_catalog"] = json.loads((cat if cat.is_absolute() else p.parent / cat).read_text())
            # Which teammate gets which role is per space, so it lives beside the
            # installed config (written in Phase 2), never in the repo.
            members = p.parent / cfg.get("members_file", "members.json")
            if members.is_file():
                cfg.setdefault("members", {}).update(json.loads(members.read_text()))
            return cfg
    die("no config: set REA_SANDBOX_CONFIG or install rea-sandbox.json")


class Session:
    """What this invocation resolves to: role, tools, engines, case, limits."""

    def __init__(self, cfg, role=None, case=None, profile="static"):
        self.cfg = cfg
        self.lab = Path(cfg["lab"])
        self.member = os.environ.get("TM8_TEAM_MEMBER_ID", "").strip()
        self.session = os.environ.get("TM8_SESSION_ID", "").strip()
        tasks = [t for t in re.split(r"[,\s]+", os.environ.get("TM8_TASK_IDS", "")) if t]
        self.tasks = [t for t in tasks if ID_RE.match(t)]
        mapped = cfg.get("members", {}).get(self.member) if self.member else None
        if role and mapped and role != mapped:
            die(f"this teammate's role is {mapped!r} (members.json); --role {role} is refused")
        if role:
            self.role_name = role
        elif mapped:
            self.role_name = mapped
        else:
            self.role_name = cfg.get("default_role", "lead")
        if self.role_name not in cfg["roles"]:
            die(f"unknown role {self.role_name!r}; roles: {', '.join(cfg['roles'])}")
        self.role = cfg["roles"][self.role_name]
        families = set(self.role["families"])
        excluded = set(self.role.get("exclude_effects", []))
        catalog = cfg["_catalog"]["tools"]
        self.role_tools = sorted(
            name
            for name, t in catalog.items()
            if t["family"] in families and not (excluded & set(t.get("effects") or []))
        )
        self.foreign = {n for n in self.role_tools if "executesForeignCode" in (catalog[n].get("effects") or [])}
        self.case_id = self._case_id(case)
        self.case = self.lab / "cases" / self.case_id
        ready = [e for e in self.role.get("engines", []) if self.engine_state(e) == "ready"]
        engines = cfg["engines"]
        self.profile = profile
        if profile == "static":  # licences mount only where no tool runs the target
            self.tools = [n for n in self.role_tools if n not in self.foreign]
            self.engines = ready
        elif profile == "exec":
            self.tools = list(self.role_tools)
            self.engines = [e for e in ready if not engines[e].get("licensed") and not engines[e].get("heavy")]
        elif profile == "cli":  # REA's CLI has no per-command filter
            self.tools = list(self.role_tools)
            self.engines = [e for e in ready if not engines[e].get("licensed")]
        else:
            die(f"unknown profile {profile!r}")
        self.exec_tmpfs = profile != "static" and bool(self.foreign)
        self.setup_engine = None  # `rea-sandbox setup` mounts this one slot read-write

    def _case_id(self, case):
        if case:
            if not CASE_RE.match(case):
                die(f"bad case name {case!r}")
            return case
        if self.tasks:
            return self.tasks[0]
        if ID_RE.match(self.session):
            return f"session-{self.session}"
        return "adhoc"

    def engine_dir(self, name):
        return self.lab / "engines" / self.cfg["engines"][name]["dir"]

    def engine_state(self, name):
        spec = self.cfg["engines"].get(name)
        if spec is None:
            return "unknown"
        if spec.get("unsupported"):
            return "unsupported"
        d = self.engine_dir(name)
        if (d / spec["check"]).exists():
            return "ready"
        if "owner_dirs" in spec:  # a licensed slot: its scaffolding (README, setup, bridge) is not the engine
            owned = [d / o for o in spec["owner_dirs"]]
            return "present" if any(o.is_dir() and any(o.iterdir()) for o in owned) else "missing"
        if not d.is_dir() or not any(p.name != "README.md" for p in d.iterdir()):
            return "missing"
        return "present"

    def ensure_case(self):
        for sub in ("targets", "out", "work"):
            (self.case / sub).mkdir(parents=True, exist_ok=True)

    def heavy(self):
        return any(self.cfg["engines"][e].get("heavy") for e in self.engines)

    def limits(self):
        return self.cfg["limits"]["heavy" if self.heavy() else "default"]


@contextlib.contextmanager
def ghidra_slot(s):
    """Hold one of N Ghidra slots for the container's life; without one, run without Ghidra."""
    if "ghidra" not in s.engines:
        yield
        return
    slots = s.lab / "run" / "ghidra-slots"
    slots.mkdir(parents=True, exist_ok=True)
    held = None
    for i in range(int(s.cfg.get("ghidra_slots", 2))):
        f = open(slots / f"slot-{i}.lock", "a+")
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            f.seek(0)
            f.truncate()
            f.write(json.dumps({"pid": os.getpid(), "case": s.case_id, "member": s.member, "since": time.time()}))
            f.flush()
            held = f
            break
        except BlockingIOError:
            f.close()
    if held is None:
        note(f"all {s.cfg.get('ghidra_slots', 2)} Ghidra slots are busy; this container runs without Ghidra (Kuna/Rizin still work)")
        s.engines = [e for e in s.engines if e != "ghidra"]
    try:
        yield
    finally:
        if held is not None:
            held.close()


def container_env(s):
    env = dict(s.cfg.get("env", {}))
    env.update({
        "HOME": "/home/rea",
        "XDG_CACHE_HOME": "/case/work/.cache",
        "XDG_CONFIG_HOME": "/home/rea/.config",
        "TM8_REA_ROLE": s.role_name,
        "TM8_REA_CASE": s.case_id,
    })
    extra_path = []
    for e in s.engines:
        spec = s.cfg["engines"][e]
        path = f"/engines/{spec['dir']}"
        for k, v in spec.get("env", {}).items():
            env[k] = v.replace("{path}", path)
        extra_path += [d.replace("{path}", path) for d in spec.get("path_append", [])]
        slot_env = s.engine_dir(e) / "slot-env.json"
        if spec.get("licensed") and slot_env.is_file():
            for k, v in json.loads(slot_env.read_text()).items():
                if re.match(r"^[A-Z][A-Z0-9_]*$", k):
                    env[k] = str(v).replace("{path}", path)
    if extra_path:
        env["PATH"] = ":".join([env.get("PATH", IMAGE_PATH)] + extra_path)
    # With Ghidra and Kuna both mounted REA's automatic choice is "ambiguous" and the
    # agent loses a turn; preset the role's first mounted preference. An explicit
    # provider_id / --provider still wins.
    for provider in s.role.get("analysis_provider", []):
        if provider in s.engines:
            env["REA_ANALYSIS_PROVIDER"] = provider
            break
    return env


def docker_argv(s, rea_args, interactive, name, extra_env=None, entrypoint=None, tty=False):
    lim = s.limits()
    uid, gid = s.cfg.get("run_uid", 110), s.cfg.get("run_gid", 114)
    argv = [
        "docker", "run", "--rm", "--name", name,
        "--runtime", s.cfg.get("runtime", "runsc"),
        "--network", "none",
        "--read-only",
        "--cap-drop", "ALL",
        "--security-opt", "no-new-privileges",
        "--cpus", str(lim["cpus"]),
        "--memory", lim["memory"], "--memory-swap", lim["memory"],
        "--pids-limit", str(lim["pids"]),
        "--tmpfs", f"/tmp:rw,nosuid,nodev,size={lim['tmp']}",
        "--tmpfs", f"/home/rea:rw,nosuid,nodev,size=512m,uid={uid},gid={gid},mode=0700",
        *(["--tmpfs", f"/exec:rw,exec,nosuid,nodev,size={lim['tmp']},uid={uid},gid={gid},mode=0700"] if s.exec_tmpfs else []),
        "-v", f"{s.case}/targets:/case/targets:ro",
        "-v", f"{s.case}/out:/case/out:rw",
        "-v", f"{s.case}/work:/case/work:rw",
        # A fixed host identity: a licensed engine that fingerprints the machine sees the same
        # one in every container (Docker's default hostname is the container id).
        "--hostname", "rea-lab",
        *(["-v", f"{s.lab}/etc/machine-id:/etc/machine-id:ro"] if (s.lab / "etc" / "machine-id").is_file() else []),
        "--label", "tm8.rea=1",
        "--label", f"tm8.rea.role={s.role_name}",
        "--label", f"tm8.rea.profile={s.profile}",
        "--label", f"tm8.rea.case={s.case_id}",
        "--label", f"tm8.rea.member={s.member or '-'}",
        "--label", f"tm8.rea.session={s.session or '-'}",
    ]
    if interactive:
        argv.insert(2, "-i")
    if tty:
        argv.insert(2, "-t")
    for e in s.engines:
        d = s.cfg["engines"][e]["dir"]
        mode = "rw" if e == s.setup_engine else "ro"
        argv += ["-v", f"{s.engine_dir(e)}:/engines/{d}:{mode}"]
    env = container_env(s)
    env.update(extra_env or {})
    for k, v in sorted(env.items()):
        argv += ["-e", f"{k}={v}"]
    if entrypoint:
        argv += ["--entrypoint", entrypoint]
    return argv + [s.cfg["image"]] + list(rea_args)


def container_name(s, mode):
    tag = re.sub(r"[^a-z0-9]", "", (s.session or s.case_id).lower())[:12] or "x"
    return f"rea-{mode}-{tag}-{uuid.uuid4().hex[:6]}"


def kill_on_signal(name):
    def handler(signum, _frame):
        subprocess.run(["docker", "kill", name], capture_output=True)
        sys.exit(128 + signum)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, handler)


