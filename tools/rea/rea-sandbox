def cmd_intake(s, args):
    s.ensure_case()
    dest_root = s.case / "targets"
    cap = int(s.cfg.get("intake_max_bytes", 4 << 30))
    rc = 0
    for src in args.sources:
        try:
            rec = intake_one(src, dest_root, args.name if len(args.sources) == 1 else None, cap)
        except (OSError, ValueError) as e:
            note(f"intake refused {src!r}: {e}")
            rc = 1
            continue
        rec.update({"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "member": s.member or None,
                    "session": s.session or None, "case": s.case_id, "note": args.note})
        with open(s.case / "work" / "intake.jsonl", "a") as f:
            f.write(json.dumps(rec) + "\n")
        print(json.dumps(rec))
    return rc


def safe_name(name):
    name = re.sub(r"[^A-Za-z0-9._-]", "_", name).lstrip(".") or "target"
    return name[:120]


def intake_one(src, dest_root, name, cap):
    if re.match(r"^[a-z]+://", src):
        u = urllib.parse.urlparse(src)
        if u.scheme != "https":
            raise ValueError("only https URLs")
        dest = dest_root / safe_name(name or Path(u.path).name or u.netloc)
        if dest.exists():
            raise ValueError(f"{dest.name} already exists in the case")
        h, n = hashlib.sha256(), 0
        part = dest.with_name(dest.name + ".part")
        with urllib.request.urlopen(src, timeout=60) as r, open(part, "wb") as f:
            while chunk := r.read(1 << 20):
                n += len(chunk)
                if n > cap:
                    part.unlink(missing_ok=True)
                    raise ValueError(f"larger than {cap} bytes")
                h.update(chunk)
                f.write(chunk)
        part.rename(dest)
        dest.chmod(0o444)
        return {"source": src, "target": f"/case/targets/{dest.name}", "sha256": h.hexdigest(), "bytes": n}
    p = Path(src)
    if p.is_symlink():
        raise ValueError("symlinks are not taken; pass the real path")
    p = p.resolve(strict=True)
    dest = dest_root / safe_name(name or p.name)
    if dest.exists():
        raise ValueError(f"{dest.name} already exists in the case")
    if p.is_file():
        if p.stat().st_size > cap:
            raise ValueError(f"larger than {cap} bytes")
        shutil.copyfile(p, dest)
        dest.chmod(0o444)
        return {"source": str(p), "target": f"/case/targets/{dest.name}", "sha256": sha256_file(dest), "bytes": dest.stat().st_size}
    if p.is_dir():
        total = 0
        for q in p.rglob("*"):
            if q.is_file() and not q.is_symlink():
                total += q.stat().st_size
                if total > cap:
                    raise ValueError(f"directory larger than {cap} bytes")
        shutil.copytree(p, dest, symlinks=True)
        manifest = hashlib.sha256()
        files = 0
        for q in sorted(dest.rglob("*")):
            if q.is_file() and not q.is_symlink():
                manifest.update(f"{q.relative_to(dest)}\0{sha256_file(q)}\n".encode())
                files += 1
        return {"source": str(p), "target": f"/case/targets/{dest.name}", "tree_sha256": manifest.hexdigest(), "files": files, "bytes": total}
    raise ValueError("not a regular file or directory")


