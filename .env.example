# tm8 environment — copy to `.env` and edit. `.env` is gitignored.
#
#   cp .env.example .env
#
# Resolution order (first wins):
#   1. the real process environment
#   2. .env.<TM8_ENV>.local     (per-developer, per-env)
#   3. .env.local               (per-developer)
#   4. .env
#   5. built-in defaults (identical to the values shown here)
#
# You do NOT need a .env to run tm8 — the defaults below are what `bun run dev`
# uses out of the box. Create one only to move a port or a data dir.
#
# You DO need a database, and nothing in `bun run dev` creates one. Run
# `./install.sh` once first; it creates the cluster, the database, the roles and
# the schema, and writes .env.<env>.local for you.
#
# Full reference: docs/ops/CONFIG.md

# ---------------------------------------------------------------------------
# Environment selector: dev | prod
#
# dev  → data ~/.tm8-dev, verbose logging, Vite UI dev server on TM8_UI_PORT
# prod → data ~/.tm8,     tm8-server serves the built web UI on TM8_PORT
#
# `bun run dev` defaults to dev; `bun run start` defaults to prod. Setting this
# explicitly overrides both.
#
# The canonical numbers for each slot live in deploy/environments.sh (ruled
# 2026-08-12): dev is 4610, prod is 17777 behind a proxy on 7777. This file used
# to imply prod was 4610, which described no instance that has ever run.
# ---------------------------------------------------------------------------
# TM8_ENV=dev

# ---------------------------------------------------------------------------
# Data directory — everything durable lives here: the sidecar Postgres cluster,
# backups, logs, the single-instance lock.
#
# MUST NOT be inside ~/.maestro or ~/.maestro-staging (live maestro's dirs).
# The launchers refuse to start if it is.
# ---------------------------------------------------------------------------
# TM8_DATA_DIR=~/.tm8-dev        # dev default
# TM8_DATA_DIR=~/.tm8            # prod default

# ---------------------------------------------------------------------------
# Ports. Chosen to never collide with live maestro (4567-4569, 4571, 3001).
#
# TM8_PORT     tm8-server: HTTP API + WebSocket + the built web UI
# TM8_UI_PORT  Vite dev server (dev only; arrives with the UI at W3/M2)
# TM8_PG_PORT  sidecar Postgres, started and owned by tm8-server (R15)
#
# Running a second tm8 stack alongside the first means changing ALL FOUR of
# TM8_DATA_DIR, TM8_PORT, TM8_UI_PORT and TM8_PG_PORT. See docs/ops/CONFIG.md.
# ---------------------------------------------------------------------------
# TM8_PORT=4610
# TM8_UI_PORT=4611
# TM8_PG_PORT=5442

# ---------------------------------------------------------------------------
# Logging: error | warn | info | debug
# ---------------------------------------------------------------------------
# TM8_LOG_LEVEL=debug            # dev default (prod: info)

# ---------------------------------------------------------------------------
# THE TWO VARIABLES THAT DECIDE WHETHER tm8 DOES ANYTHING AT ALL
#
# These were missing from this file until 2026-08-12, and their absence was the
# whole onboarding bug. Without TM8_DATABASE_URL the server still boots, still
# listens, still answers /health — and logs
#
#     graph: NOT CONFIGURED (set TM8_DATABASE_URL) — all operations answer 501
#
# while every one of the 141 catalog operations answers 501 not_implemented. It
# looks like a running tm8. It is an empty shell.
#
# TM8_DELIVERY_DATABASE_URL must AUTHENTICATE as `tm8_delivery_worker` — being
# able to SET ROLE to it is NOT enough, and the server checks the difference.
# The role is created passwordless by db/migrations/015, so the cluster has to
# trust loopback for it to connect. `./install.sh` sets all of this up; see its
# PHASE 3 for why trust is safe here (the cluster binds 127.0.0.1 only).
#
# Defaults shown are the `dev` slot from deploy/environments.sh — the one
# topology table. Run `bash deploy/environments.sh` to print every slot.
# ---------------------------------------------------------------------------
# TM8_DATABASE_URL=postgres://tm8@127.0.0.1:5442/tm8_dev
# TM8_DELIVERY_DATABASE_URL=postgres://tm8_delivery_worker@127.0.0.1:5442/tm8_dev

# ---------------------------------------------------------------------------
# CI / tooling only
#
# TM8_MIGRATION_DATABASE_URL  where tools/ci/migrations-check.sh applies the
#                             sequence. Unset locally → it uses the sidecar on
#                             TM8_PG_PORT, and skips loudly if nothing is there.
# ---------------------------------------------------------------------------
# TM8_MIGRATION_DATABASE_URL=postgres://postgres@localhost:5442/postgres
