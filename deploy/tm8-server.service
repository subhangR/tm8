# tm8 systemd unit — REFERENCE TEMPLATE.
#
# You normally do not install this by hand. `./install.sh --env <slot> --systemd`
# renders this same unit with the slot's real values and installs it as
# /etc/systemd/system/tm8-<slot>.service. Keep this file only as the thing to
# read when you want to know what that will write.
#
# Replace @SLOT@ (prod|staging|private), @PORT@, @PG_MAJOR@, @PG_CLUSTER@ and
# @USER@ if you are doing it manually. Current slots and their ports are in
# deploy/environments.sh — run `bash deploy/environments.sh` to print the table.
#
# WHAT WAS WRONG WITH THE PREVIOUS VERSION OF THIS FILE
#
# It was checked in describing a machine that has never existed, and it was
# wrong in four independent ways at once:
#
#   User=ubuntu                            the services run as tm8
#   WorkingDirectory=/home/ubuntu/tm8-workspace   no such path, ever
#   ExecStart=… /opt/tm8/current/…         no such path; checkouts are /opt/tm8/<slot>
#   Requires=postgresql.service            no such unit on a box with per-cluster
#                                          units; the real dependency is
#                                          postgresql@<major>-<cluster>.service
#
# Anyone who trusted it got a unit that could not start, and the four errors
# surfaced one at a time.
#
# TWO THINGS THAT ARE LOAD-BEARING HERE
#
# 1. After=, not Requires=, on Postgres. Requires= couples the units so hard that
#    a Postgres restart takes tm8 down with it and leaves it down. After= gives
#    the ordering, which is what is actually wanted; Restart= handles the
#    reconnect.
#
# 2. Restart=always, NOT on-failure — and this is load-bearing for agent safety,
#    not just uptime.
#
#    The server exits 0 on SIGTERM (main.ts's handler). Under the previous
#    Restart=on-failure that made `kill -TERM` leave the unit INACTIVE and the
#    instance silently DOWN, so the only safe restart verb was systemctl — which needs
#    root. An operator without passwordless sudo therefore had exactly one way
#    to cycle this service: SIGKILL the main PID, which is a "failure" exit and
#    so does get restarted. That is precisely what /home/tm8/deploy-main.sh
#    does, and on 2026-08-22 11:04 it killed four live agents.
#
#    SIGKILL is the worst possible way to stop this process: no shutdown handler
#    runs, so nothing records WHY any live session died, and the next process
#    can only infer it. Under Restart=always a plain `kill -TERM` is a correct,
#    complete restart — the handler runs, every live session is annotated with a
#    plain-English reason (169), and systemd brings the unit back. The hard kill
#    stops being necessary.
#
#    `systemctl stop` still stops the unit and keeps it stopped: an explicit
#    stop is not a restart trigger under any Restart= setting. So this does not
#    take the stop verb away from anyone.
#
#    WHAT THIS DOES NOT DO: it does not keep agents alive across the restart.
#    Their PTY masters live in this process and die with it — measured, see
#    docs/ops/agent-survival-across-restarts.md. This makes the death honest and
#    graceful, not avoidable.

[Unit]
Description=tm8 @SLOT@ server (@PORT@)
After=network-online.target postgresql@@PG_MAJOR@-@PG_CLUSTER@.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=/opt/tm8/@SLOT@
EnvironmentFile=/etc/tm8/@SLOT@.env
ExecStart=/usr/bin/node --enable-source-maps /opt/tm8/@SLOT@/packages/server/dist/index.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
