server {
  listen 80;
  listen [::]:80;
  server_name tm8.sh;

  access_log /var/log/nginx/tm8-public-access.log tm8_noargs;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/tm8-acme;
    default_type text/plain;
    try_files $uri =404;
  }

  # Drop query arguments at the insecure boundary. tm8 credentials never
  # belong in URLs, and an accidental argument must not be reflected into a
  # Location header or carried onto the TLS endpoint.
  location / { return 308 https://tm8.sh$uri; }
}

server {
  # Utho currently ships nginx before the standalone `http2 on` directive.
  # Keep HTTP/2 on the listen socket so this passes the live binary's parser.
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name tm8.sh;

  ssl_certificate     /etc/letsencrypt/live/tm8.sh/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/tm8.sh/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:tm8_tls:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  server_tokens off;
  add_header Strict-Transport-Security "max-age=31536000" always;
  access_log /var/log/nginx/tm8-public-access.log tm8_noargs;
  error_log  /var/log/nginx/tm8-public-error.log warn;
  client_max_body_size 64m;

  # Event and PTY sockets share this catalog path. The application performs
  # exact Origin/Host checks, cookie authentication, and one-shot PTY grant
  # consumption before the 101. Nginx adds coarse per-client admission.
  location = /v2/ws {
    limit_except GET { deny all; }
    limit_req zone=tm8_ws_upgrade burst=20 nodelay;
    limit_conn tm8_ws_client 8;

    proxy_pass http://127.0.0.1:17777;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $tm8_connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_socket_keepalive on;
    proxy_read_timeout 75m;
    proxy_send_timeout 75m;
  }

  location = /favicon.ico { access_log off; return 204; }

  location = /index.html {
    add_header Cache-Control "no-store, must-revalidate" always;
    proxy_pass http://127.0.0.1:17777;
    include snippets/tm8-proxy-api.conf;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    proxy_pass http://127.0.0.1:17777;
    include snippets/tm8-proxy-api.conf;
  }

  location / {
    add_header Cache-Control "no-store, must-revalidate" always;
    proxy_pass http://127.0.0.1:17777;
    include snippets/tm8-proxy-api.conf;
  }
}
