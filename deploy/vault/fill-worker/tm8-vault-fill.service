[Unit]
Description=tm8 isolated vault browser fill worker
After=network.target

[Service]
Type=simple
User=tm8-vault-fill
Group=tm8-vault
WorkingDirectory=/opt/tm8/current
Environment=NODE_ENV=production
Environment=TMPDIR=/tmp
Environment=TM8_VAULT_FILL_SOCKET=/run/tm8-vault/fill.sock
Environment=TM8_VAULT_FILL_TIMEOUT_MS=30000
Environment=TM8_VAULT_CHROMIUM_EXECUTABLE=/opt/tm8/chromium/chrome
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/tm8/playwright-browsers
ExecStart=/usr/bin/node /opt/tm8/current/packages/vault/dist/browser/worker-main.js
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillMode=control-group
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Playwright's temporary profile, cache and artifacts exist only on this tmpfs.
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,mode=1777,size=512M
ReadWritePaths=/run/tm8-vault
LimitCORE=0
MemorySwapMax=0
MemoryMax=1G
TasksMax=256
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
