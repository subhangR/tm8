TM8_ENV=prod
TM8_CONTROL_ORIGIN=https://login.example.com
TM8_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
TM8_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# A backend PostgreSQL connection to the central Supabase project. Never use
# this connection on a workspace node or expose this file to the browser.
TM8_CONTROL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
